// ╔══════════════════════════════════════════════════════════════════════════╗
// ║       Trend-Follow Top-10 Grid v2  [SPOT]  —  Pine Script v5           ║
// ╠══════════════════════════════════════════════════════════════════════════╣
// ║  ИСПРАВЛЕНО (vs первая версия v2):                                     ║
// ║                                                                        ║
// ║  БАГ 1 — Каскадный grid_ref                                           ║
// ║    Было:  grid_ref двигался по СИГНАЛУ, ордер шёл на следующий бар     ║
// ║           → в тренде стратегия продавала каждый бар, а гэп давал       ║
// ║             нереально высокую цену исполнения                           ║
// ║    Стало: grid_ref обновляется только по ФАКТУ исполнения ордера       ║
// ║           (pos_change = position_size − prev_position)                 ║
// ║                                                                        ║
// ║  БАГ 2 — strategy.equity раздувал размеры ордеров                     ║
// ║    Было:  alloc = strategy.equity × % → включал нереализованный P&L    ║
// ║           → при росте цены ордера росли экспоненциально               ║
// ║    Стало: alloc = (initial_capital + netprofit) × %  (только реализов.)║
// ║                                                                        ║
// ║  БАГ 3 — Рыночные ордера вместо лимитных                              ║
// ║    Было:  strategy.order без limit= → исполнение по цене открытия      ║
// ║           следующего бара (при гэпах — нереальный профит)             ║
// ║    Стало: limit=buy_level / limit=sell_level → исполнение на уровне    ║
// ║                                                                        ║
// ║  СОХРАНЕНО из v2:                                                      ║
// ║  • Вход немедленно при запуске                                         ║
// ║  • Частичные продажи (1 слой)                                          ║
// ║  • Верхняя граница = 52w High, трейлинг только вверх                  ║
// ║  • SMA200−2σ — только пол, не сигнал входа                            ║
// ║  • Ежемесячный аудит при смене месяца                                  ║
// ║  • 100% реинвест (через реализованный капитал)                         ║
// ╚══════════════════════════════════════════════════════════════════════════╝

//@version=5
strategy(
    title                   = "Trend-Follow Top-10 Grid v2 [SPOT]",
    shorttitle               = "TF-Grid v2",
    overlay                  = true,
    initial_capital          = 10000,
    default_qty_type         = strategy.cash,
    default_qty_value        = 100,
    commission_type          = strategy.commission.percent,
    commission_value         = 0.1,
    slippage                 = 1,
    pyramiding               = 100,
    process_orders_on_close  = false
)

// ══════════════════════════════════════════════════════════════════════════════
//  ПАРАМЕТРЫ
// ══════════════════════════════════════════════════════════════════════════════

var string GRP_DATE = "📅 Период тестирования"
var string GRP_IND  = "📊 Индикаторы"
var string GRP_GRID = "🔲 Настройки сетки"
var string GRP_VIS  = "🎨 Визуализация"

// ── Период тестирования ──────────────────────────────────────────────────────
i_use_range  = input.bool(false, "Ограничить период",
     group   = GRP_DATE,
     tooltip = "Если включено — стратегия торгует только между датами ниже")

i_start_date = input.time(
     timestamp("2020-01-01 00:00"), "Дата старта",
     group   = GRP_DATE,
     tooltip = "Первый бар, на котором разрешён вход (включительно)")

i_end_date   = input.time(
     timestamp("2025-12-31 00:00"), "Дата финиша",
     group   = GRP_DATE,
     tooltip = "Последний бар, на котором разрешена торговля (включительно). "
             + "После этой даты все позиции закрываются.")

i_sma_len = input.int(
     200, "Период SMA",
     group   = GRP_IND, minval = 50, maxval = 500,
     tooltip = "SMA для расчёта базовой линии тренда и пола сетки (стандарт — 200)")

i_atr_len = input.int(
     30, "Период ATR",
     group   = GRP_IND, minval = 5, maxval = 200,
     tooltip = "ATR для расчёта динамического шага сетки (стандарт — 30)")

i_bb_mult = input.float(
     2.0, "Множитель StdDev (пол сетки)",
     group   = GRP_IND, step = 0.1, minval = 0.5, maxval = 5.0,
     tooltip = "Пол = SMA(200) − N × StdDev(200). Покупки ниже пола не происходят.")

i_step_mult = input.float(
     0.15, "Множитель ATR для шага сетки",
     group   = GRP_GRID, step = 0.01, minval = 0.01, maxval = 5.0,
     tooltip = "Шаг % = ATR(30) × Mult / Цена × 100")

i_alloc_pct = input.float(
     10.0, "% капитала на монету",
     group   = GRP_GRID, step = 1.0, minval = 1.0, maxval = 100.0,
     tooltip = "% от реализованного капитала на монету. "
             + "Делится на кол-во уровней. Реализованная прибыль реинвестируется.")

i_show_floor = input.bool(true,  "Пол сетки (BB Lower)",      group = GRP_VIS)
i_show_sma   = input.bool(true,  "SMA 200",                   group = GRP_VIS)
i_show_top   = input.bool(true,  "Верхняя граница (Trail ↑)", group = GRP_VIS)
i_show_grid  = input.bool(true,  "Уровни Buy / Sell",         group = GRP_VIS)
i_show_month = input.bool(true,  "Метки аудита",              group = GRP_VIS)
i_show_table = input.bool(true,  "Таблица параметров",        group = GRP_VIS)

// ══════════════════════════════════════════════════════════════════════════════
//  ИНДИКАТОРЫ
// ══════════════════════════════════════════════════════════════════════════════

sma200    = ta.sma(close,  i_sma_len)
std200    = ta.stdev(close, i_sma_len)
floor_bb  = sma200 - i_bb_mult * std200   // Пол: SMA200 − 2σ

atr30     = ta.atr(i_atr_len)
step_frac = atr30 * i_step_mult / close   // Шаг сетки как дробь

high_52w  = ta.highest(high, 365)          // 52-недельный max (исходная верхняя граница)

is_ready  = not na(sma200) and not na(atr30) and not na(high_52w)

// Находимся ли мы внутри разрешённого периода?
// Если i_use_range = false — всегда true (без ограничений)
in_range  = not i_use_range or (time >= i_start_date and time <= i_end_date)

// Первый бар за пределами периода → закрываем всё
just_ended = i_use_range and not in_range and in_range[1]

// ══════════════════════════════════════════════════════════════════════════════
//  СОСТОЯНИЕ СЕТКИ
// ══════════════════════════════════════════════════════════════════════════════
//
//  grid_bottom  — нижняя граница (≥ floor_bb, не падает, поднимается при аудите)
//  grid_top     — верхняя граница (52w High → трейлинг ТОЛЬКО вверх)
//  grid_ref     — опорная цена для расчёта buy/sell уровней
//
//  КЛЮЧЕВОЕ: grid_ref обновляется ТОЛЬКО когда ордер фактически исполнился
//  (определяется через изменение strategy.position_size между барами)
//
//  При исполнении покупки:  grid_ref → buy_level (предыдущего бара)
//  При исполнении продажи:  grid_ref → sell_level (предыдущего бара)
//  При трейлинге вверх:     grid_top ↑, grid_bottom ↑ (убирает нижний слот)
//  При падении:             сетка не двигается

var float grid_bottom = na
var float grid_top    = na
var float grid_ref    = na
var bool  initialized = false
var bool  entry_done  = false

// Для детекции исполнения: храним позицию и уровни предыдущего бара
var float prev_pos    = 0.0
var float prev_buy_l  = na
var float prev_sell_l = na

// ── Инициализация ───────────────────────────────────────────────────────────
if is_ready and in_range and not initialized
    grid_bottom := floor_bb
    grid_top    := math.max(high_52w, close * (1.0 + step_frac * 2.0))
    grid_ref    := close
    initialized := true

// ══════════════════════════════════════════════════════════════════════════════
//  ДЕТЕКЦИЯ ИСПОЛНЕНИЯ ОРДЕРА — обновляем grid_ref ТОЛЬКО по факту
// ══════════════════════════════════════════════════════════════════════════════
//
//  Pine Script исполняет ордера на открытии следующего бара.
//  strategy.position_size на баре N уже отражает все исполнения на открытии N.
//  Сравниваем с prev_pos (значение после бара N-1) → видим факт исполнения.

pos_change = strategy.position_size - prev_pos

if pos_change > 0.0 and not na(prev_buy_l)
    // Покупка исполнилась → опора вниз на один шаг
    grid_ref := prev_buy_l

if pos_change < 0.0 and not na(prev_sell_l)
    // Продажа исполнилась → опора вверх на один шаг
    new_ref = prev_sell_l
    // Трейлинг: если продали выше старого grid_top → расширяем сетку вверх
    if new_ref >= grid_top
        grid_top    := new_ref * (1.0 + step_frac)     // новая верхняя граница
        grid_bottom := grid_bottom * (1.0 + step_frac)  // убираем нижний слот
    grid_ref := new_ref

// Сохраняем позицию текущего бара для следующего
prev_pos := strategy.position_size

// ══════════════════════════════════════════════════════════════════════════════
//  ЕЖЕМЕСЯЧНЫЙ АУДИТ — подтяжка нижней границы вверх (при смене месяца)
// ══════════════════════════════════════════════════════════════════════════════

is_month_start = month != month[1] and is_ready

if is_month_start and not na(grid_bottom)
    if floor_bb > grid_bottom
        grid_bottom := floor_bb

// ══════════════════════════════════════════════════════════════════════════════
//  ТРЕЙЛИНГ ВЕРХНЕЙ ГРАНИЦЫ — ТОЛЬКО ВВЕРХ (обработка гэпов выше grid_top)
// ══════════════════════════════════════════════════════════════════════════════
//
//  Если цена закрылась выше grid_top (гэп), корректируем сетку.
//  При ПАДЕНИИ цены — ничего не меняем.

if is_ready and not na(grid_top) and not na(grid_bottom) and close > grid_top
    n_steps = math.ceil(math.log(close / grid_top) / math.log(1.0 + step_frac))
    if n_steps > 0
        mult         = math.pow(1.0 + step_frac, float(n_steps))
        grid_top    := grid_top    * mult
        grid_bottom := grid_bottom * mult
        // Выравниваем grid_ref под текущую цену
        ref_idx      = math.floor(math.log(close / grid_bottom) / math.log(1.0 + step_frac))
        grid_ref    := grid_bottom * math.pow(1.0 + step_frac, float(ref_idx))

// ══════════════════════════════════════════════════════════════════════════════
//  ПРОИЗВОДНЫЕ ПАРАМЕТРЫ
// ══════════════════════════════════════════════════════════════════════════════

n_levels = (not na(grid_bottom) and not na(grid_top) and grid_top > grid_bottom)
           ? math.max(2, math.round(math.log(grid_top / grid_bottom) / math.log(1.0 + step_frac)))
           : 10

// Размер ордера — от РЕАЛИЗОВАННОГО капитала (initial + закрытые сделки)
// Не включает нереализованный P&L → не раздувает ордера при росте цены
realized_cap = strategy.initial_capital + strategy.netprofit
alloc_cap    = realized_cap * i_alloc_pct / 100.0
order_usd    = alloc_cap / float(n_levels)
order_qty    = order_usd / close

// Уровни покупки / продажи
buy_level  = not na(grid_ref) ? grid_ref * (1.0 - step_frac) : na
sell_level = not na(grid_ref) ? grid_ref * (1.0 + step_frac) : na

above_floor = not na(grid_bottom) and close > grid_bottom

// ══════════════════════════════════════════════════════════════════════════════
//  ПЕРВИЧНЫЙ ВХОД (рыночный, однократно при запуске)
// ══════════════════════════════════════════════════════════════════════════════

if initialized and in_range and not entry_done
    strategy.order("Init", strategy.long, qty = order_qty, comment = "▶ Старт")
    entry_done := true

// Закрываем все позиции на первом баре ПОСЛЕ окончания периода
if just_ended
    strategy.cancel("BuyGrid")
    strategy.cancel("SellGrid")
    strategy.close_all(comment = "⏹ Конец периода")

// ══════════════════════════════════════════════════════════════════════════════
//  ЛИМИТНЫЕ ОРДЕРА СЕТКИ (обновляются каждый бар)
// ══════════════════════════════════════════════════════════════════════════════
//
//  Используем ПОСТОЯННЫЕ ID ("BuyGrid" / "SellGrid") — strategy.order с
//  одним ID отменяет предыдущий и ставит новый → всегда только 1 заявка
//  на покупку и 1 на продажу. Исполнение строго на уровне (limit=).

if entry_done and in_range and not na(buy_level) and above_floor and buy_level >= grid_bottom
    strategy.order(
         id        = "BuyGrid",
         direction = strategy.long,
         qty       = order_qty,
         limit     = buy_level,
         comment   = "▼ Buy")
else
    strategy.cancel("BuyGrid")

if entry_done and in_range and strategy.position_size > 0.0 and not na(sell_level)
    s_qty = math.min(order_qty, strategy.position_size)
    strategy.order(
         id        = "SellGrid",
         direction = strategy.short,
         qty       = s_qty,
         limit     = sell_level,
         comment   = "▲ TP")
else
    strategy.cancel("SellGrid")

// Защита: если из-за флоат-погрешности позиция стала отрицательной → закрыть
if strategy.position_size < 0.0
    strategy.close_all(comment = "⚠ Safety close")

// ── Сохраняем уровни текущего бара для детекции исполнения ─────────────────
prev_buy_l  := buy_level
prev_sell_l := sell_level

// ══════════════════════════════════════════════════════════════════════════════
//  ЕЖЕМЕСЯЧНЫЙ АУДИТ — МЕТКИ НА ГРАФИКЕ
// ══════════════════════════════════════════════════════════════════════════════

if is_month_start and i_show_month
    label.new(
         x         = bar_index,
         y         = high,
         text      = "📅 Аудит\n"
                   + "Пол:     " + str.tostring(floor_bb,   "#.4f") + "\n"
                   + "Верх:    " + str.tostring(grid_top,   "#.4f") + "\n"
                   + "Шаг:     " + str.tostring(step_frac * 100.0, "0.00") + "%\n"
                   + "Уровней: " + str.tostring(n_levels),
         color     = color.new(color.purple, 50),
         textcolor = color.white,
         style     = label.style_label_down,
         size      = size.tiny,
         yloc      = yloc.abovebar)

// ══════════════════════════════════════════════════════════════════════════════
//  ВИЗУАЛИЗАЦИЯ
// ══════════════════════════════════════════════════════════════════════════════

p_floor = plot(
     i_show_floor ? floor_bb : na, "Пол (BB Lower)",
     color     = color.new(color.red,  15),
     linewidth = 2)

p_sma = plot(
     i_show_sma ? sma200 : na, "SMA 200",
     color     = color.new(color.blue, 30),
     linewidth = 1)

fill(p_floor, p_sma, color = color.new(color.red, 90), title = "Пол–SMA зона")

plot(
     i_show_top ? grid_top : na, "Верхняя граница (Trail ↑)",
     color     = color.new(color.orange, 25),
     linewidth = 2,
     style     = plot.style_stepline)

plot(
     i_show_grid and not na(buy_level)  ? buy_level  : na, "Следующая покупка",
     color = color.new(color.lime,   20),
     style = plot.style_circles,
     linewidth = 1)

plot(
     i_show_grid and not na(sell_level) ? sell_level : na, "Следующая продажа",
     color = color.new(color.orange, 20),
     style = plot.style_circles,
     linewidth = 1)

bgcolor(
     is_ready and not above_floor ? color.new(color.red, 88) : na,
     title = "Ниже пола — покупки приостановлены")

// Серый фон вне торгового периода
bgcolor(
     i_use_range and not in_range ? color.new(color.gray, 88) : na,
     title = "Вне торгового периода")

// ══════════════════════════════════════════════════════════════════════════════
//  ИНФОРМАЦИОННАЯ ТАБЛИЦА
// ══════════════════════════════════════════════════════════════════════════════

if i_show_table and barstate.islast
    var table T = table.new(
         position     = position.top_right,
         columns      = 2,
         rows         = 16,
         bgcolor      = color.new(color.black, 72),
         border_width = 1,
         border_color = color.new(color.gray, 50),
         frame_width  = 1,
         frame_color  = color.new(color.gray, 30))

    c_hdr = color.new(color.navy, 20)
    c_lbl = color.new(color.silver, 0)

    table.cell(T, 0, 0, "TF-Grid v2 [SPOT]",
         bgcolor = c_hdr, text_color = color.white, text_halign = text.align_center)
    table.cell(T, 1, 0, "Limit Orders + Fill Det.",
         bgcolor = c_hdr, text_color = color.aqua, text_halign = text.align_center)

    table.cell(T, 0, 1,  "SMA 200",            text_color = c_lbl)
    table.cell(T, 1, 1,  str.tostring(sma200,    "#.4f"),  text_color = color.blue)

    table.cell(T, 0, 2,  "Пол (BB Lower)",      text_color = c_lbl)
    table.cell(T, 1, 2,  str.tostring(floor_bb,  "#.4f"),  text_color = color.red)

    table.cell(T, 0, 3,  "Grid Bottom",          text_color = c_lbl)
    table.cell(T, 1, 3,  na(grid_bottom) ? "—" : str.tostring(grid_bottom, "#.4f"),
         text_color = color.red)

    table.cell(T, 0, 4,  "Grid Top (Trail ↑)",   text_color = c_lbl)
    table.cell(T, 1, 4,  na(grid_top) ? "—" : str.tostring(grid_top, "#.4f"),
         text_color = color.orange)

    table.cell(T, 0, 5,  "Уровней в сетке",      text_color = c_lbl)
    table.cell(T, 1, 5,  str.tostring(n_levels),  text_color = color.yellow)

    table.cell(T, 0, 6,  "ATR(" + str.tostring(i_atr_len) + ")", text_color = c_lbl)
    table.cell(T, 1, 6,  str.tostring(atr30,      "#.4f"),  text_color = color.yellow)

    table.cell(T, 0, 7,  "Шаг сетки %",          text_color = c_lbl)
    table.cell(T, 1, 7,  str.tostring(step_frac * 100.0, "0.00") + " %",
         text_color = color.yellow)

    table.cell(T, 0, 8,  "Grid Ref",              text_color = c_lbl)
    table.cell(T, 1, 8,  na(grid_ref) ? "—" : str.tostring(grid_ref, "#.4f"),
         text_color = color.white)

    table.cell(T, 0, 9,  "Buy Level (лимит)",     text_color = c_lbl)
    table.cell(T, 1, 9,  na(buy_level)  ? "—" : str.tostring(buy_level,  "#.4f"),
         text_color = color.lime)

    table.cell(T, 0, 10, "Sell Level (лимит)",    text_color = c_lbl)
    table.cell(T, 1, 10, na(sell_level) ? "—" : str.tostring(sell_level, "#.4f"),
         text_color = color.orange)

    table.cell(T, 0, 11, "Ордер ($)",             text_color = c_lbl)
    table.cell(T, 1, 11, str.tostring(order_usd, "#.2f") + " $",
         text_color = color.white)

    table.cell(T, 0, 12, "Позиция",               text_color = c_lbl)
    table.cell(T, 1, 12, str.tostring(strategy.position_size, "#.######"),
         text_color = color.white)

    table.cell(T, 0, 13, "Реализ. капитал",       text_color = c_lbl)
    table.cell(T, 1, 13, str.tostring(realized_cap, "#.2f") + " $",
         text_color = color.teal)

    table.cell(T, 0, 14, "Период активен",        text_color = c_lbl)
    table.cell(T, 1, 14, i_use_range ? (in_range ? "✔ Да" : "✘ Нет") : "Без ограничений",
         text_color = i_use_range ? (in_range ? color.lime : color.red) : color.gray)

    table.cell(T, 0, 15, "Старт / Финиш",         text_color = c_lbl)
    table.cell(T, 1, 15, i_use_range
         ? str.format_time(i_start_date, "dd.MM.yy") + " – " + str.format_time(i_end_date, "dd.MM.yy")
         : "—",
         text_color = color.gray)
